{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "node", "promise"],
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "warn"
  },
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "rules": {
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "ignorePatterns": ["dist"]
}
